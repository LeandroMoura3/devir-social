# Copie este arquivo para .env.local e preencha com os dados do seu projeto no Supabase
# (Project Settings → API Keys, e o endereço em Connect ou Project Settings → Data API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Endereço do app no ar (na Vercel). Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
